
@model OnixSystem_MVC.Models.Entidades.Fornecedor

@{
    ViewData["Title"] = "Atualizar Fornecedor";
}

<div class="container mt-4">

    <h2 class="mb-4">Atualizar Fornecedor</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-controller="Fornecedor"
                  asp-action="AtualizarPost"
                  method="post">

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="RazaoSocial" class="form-label">Razão Social</label>
                    <input asp-for="RazaoSocial"
                           class="form-control"
                           placeholder="Digite a razão social"
                           required />
                    <span asp-validation-for="RazaoSocial" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CNPJ" class="form-label">CNPJ</label>
                    <input asp-for="CNPJ"
                           class="form-control"
                           placeholder="Digite o CNPJ"
                           required />
                    <span asp-validation-for="CNPJ" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Telefone" class="form-label">Telefone</label>
                    <input asp-for="Telefone"
                           class="form-control"
                           placeholder="Digite o telefone"
                           required />
                    <span asp-validation-for="Telefone" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">E-mail</label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Digite o e-mail"
                           required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Endereco" class="form-label">Endereço</label>
                    <input asp-for="Endereco"
                           class="form-control"
                           placeholder="Digite o endereço"
                           required />
                    <span asp-validation-for="Endereco" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        Salvar Alterações
                    </button>

                    <a asp-controller="Fornecedor"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Voltar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

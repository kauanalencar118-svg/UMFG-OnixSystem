
@model IEnumerable<OnixSystem_MVC.Models.Entidades.Fornecedor>

@{
    ViewData["Title"] = "Fornecedores";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Lista de Fornecedores</h2>

        <a asp-controller="Fornecedor"
           asp-action="Criar"
           class="btn btn-primary">
            Novo Fornecedor
        </a>
    </div>

    <form asp-controller="Fornecedor" asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text"
                   name="pesquisa"
                   value="@ViewBag.Pesquisa"
                   class="form-control"
                   placeholder="Pesquisar por razão social, CNPJ, telefone ou e-mail..." />

            <button type="submit" class="btn btn-dark">
                Pesquisar
            </button>

            <a asp-controller="Fornecedor"
               asp-action="Index"
               class="btn btn-secondary">
                Limpar
            </a>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-striped table-hover">

                    <thead class="table-dark">
                        <tr>
                            <th>Razão Social</th>
                            <th>CNPJ</th>
                            <th>Telefone</th>
                            <th>E-mail</th>
                            <th>Endereço</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var fornecedor in Model)
                            {
                                <tr>
                                    <td>@fornecedor.RazaoSocial</td>
                                    <td>@fornecedor.CNPJ</td>
                                    <td>@fornecedor.Telefone</td>
                                    <td>@fornecedor.Email</td>
                                    <td>@fornecedor.Endereco</td>

                                    <td class="text-center">

                                        <a asp-controller="Fornecedor"
                                           asp-action="Atualizar"
                                           asp-route-id="@fornecedor.Id"
                                           class="btn btn-warning btn-sm">
                                            Editar
                                        </a>

                                        <a asp-controller="Fornecedor"
                                           asp-action="DeleteSoft"
                                           asp-route-id="@fornecedor.Id"
                                           class="btn btn-danger btn-sm">
                                            Desativar
                                        </a>

                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">
                                    Nenhum fornecedor encontrado.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Fornecedor"
           asp-action="Inativos"
           class="btn btn-secondary">
            Fornecedores Inativos
        </a>
    </div>

</div>


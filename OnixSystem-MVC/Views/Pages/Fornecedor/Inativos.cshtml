
@model IEnumerable<OnixSystem_MVC.Models.Entidades.Fornecedor>

@{
    ViewData["Title"] = "Fornecedores Inativos";
}

<div class="container mt-4">

    <h2 class="mb-4">Fornecedores Inativos</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-striped table-hover">

                    <thead class="table-dark">
                        <tr>
                            <th>Razão Social</th>
                            <th>CNPJ</th>
                            <th>Telefone</th>
                            <th>E-mail</th>
                            <th>Endereço</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var fornecedor in Model)
                            {
                                <tr>
                                    <td>@fornecedor.RazaoSocial</td>
                                    <td>@fornecedor.CNPJ</td>
                                    <td>@fornecedor.Telefone</td>
                                    <td>@fornecedor.Email</td>
                                    <td>@fornecedor.Endereco</td>

                                    <td class="text-center">
                                        <form asp-controller="Fornecedor"
                                              asp-action="Reativar"
                                              asp-route-id="@fornecedor.Id"
                                              method="post">

                                            <button type="submit" class="btn btn-success btn-sm">
                                                Reativar
                                            </button>

                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">
                                    Nenhum fornecedor inativo encontrado.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Fornecedor"
           asp-action="Index"
           class="btn btn-secondary">
            Voltar
        </a>
    </div>

</div>

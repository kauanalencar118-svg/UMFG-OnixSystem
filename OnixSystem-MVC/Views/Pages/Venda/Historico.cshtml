
@model IEnumerable<OnixSystem_MVC.Models.Entidades.Venda>

@{
    ViewData["Title"] = "Histórico de Vendas";
}

<style>
    .historico-container {
        padding: 20px;
    }

    .historico-tabela-container {
        max-height: calc(100vh - 260px);
        min-height: 300px;
        overflow-y: auto;
        overflow-x: auto;
    }

    .historico-tabela-container thead {
        position: sticky;
        top: 0;
        z-index: 2;
        background: white;
    }

    .historico-tabela-container thead th {
        background: #f8f9fa;
    }

    .codigo-venda {
        font-weight: 600;
        color: #495057;
        white-space: nowrap;
    }
</style>

<div class="container-fluid historico-container">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">

        <div>
            <h2 class="mb-1">Histórico de Vendas</h2>
            <p class="text-muted mb-0">
                Consulte as vendas realizadas pela loja.
            </p>
        </div>

        <a asp-controller="Venda"
           asp-action="Index"
           class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>
            Voltar
        </a>

    </div>

    <!-- MENSAGENS -->
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- TABELA -->
    <div class="card shadow-sm">

        <div class="card-body p-0">

            <div class="historico-tabela-container">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Data</th>
                            <th>Subtotal</th>
                            <th>Desconto</th>
                            <th>Total</th>
                            <th>Pagamento</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var venda in Model)
                            {
                                <tr>

                                    <!-- CÓDIGO -->
                                    <td class="codigo-venda"
                                        title="@venda.Id">
                                        @venda.Id.ToString().Substring(0, 8).ToUpper()
                                    </td>

                                    <!-- DATA -->
                                    <td>
                                        @venda.DataVenda.ToString("dd/MM/yyyy HH:mm:ss")
                                    </td>

                                    <!-- SUBTOTAL -->
                                    <td>
                                        @venda.Subtotal.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                                    </td>

                                    <!-- DESCONTO -->
                                    <td>
                                        @venda.Desconto.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                                    </td>

                                    <!-- TOTAL -->
                                    <td>
                                        <strong>
                                            @venda.ValorTotal.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                                        </strong>
                                    </td>

                                    <!-- PAGAMENTO -->
                                    <td>
                                        @venda.FormaPagamento
                                    </td>

                                    <!-- AÇÕES -->
                                    <td class="text-center">

                                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                                            <!-- CONSULTAR -->
                                            <a asp-controller="Venda"
                                               asp-action="Consultar"
                                               asp-route-id="@venda.Id"
                                               class="btn btn-primary btn-sm">
                                                <i class="fas fa-eye me-1"></i>
                                                Consultar
                                            </a>

                                            <!-- CANCELAR -->
                                            <button type="button"
                                                    class="btn btn-danger btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalCancelarVenda"
                                                    data-venda-id="@venda.Id"
                                                    data-venda-codigo="@venda.Id.ToString().Substring(0, 8).ToUpper()">

                                                <i class="fas fa-ban me-1"></i>
                                                Cancelar
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-4">
                                    Nenhuma venda registrada.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- MODAL CANCELAR VENDA -->
<div class="modal fade"
     id="modalCancelarVenda"
     tabindex="-1"
     aria-labelledby="modalCancelarVendaLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form asp-controller="Venda"
                  asp-action="ExcluirVenda"
                  method="post">

                <div class="modal-header">

                    <h5 class="modal-title" id="modalCancelarVendaLabel">
                        <i class="fas fa-exclamation-triangle text-danger me-2"></i>
                        Cancelar Venda
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Fechar">
                    </button>

                </div>

                <div class="modal-body">

                    <input type="hidden" name="id" id="cancelarVendaId" />

                    <p>
                        Você está prestes a cancelar a venda
                        <strong id="cancelarVendaCodigo"></strong>.
                    </p>

                    <p class="text-danger">
                        O estoque dos produtos será devolvido.
                    </p>

                    <div class="mb-3">

                        <label for="senhaCancelarVenda"
                               class="form-label">
                            Senha do sistema
                        </label>

                        <input type="password"
                               class="form-control"
                               id="senhaCancelarVenda"
                               name="senha"
                               placeholder="Digite a senha"
                               required
                               autocomplete="off" />

                    </div>

                    <small class="text-muted">
                        Essa ação cancelará a venda, mas o registro continuará
                        armazenado no banco de dados.
                    </small>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Voltar
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        <i class="fas fa-ban me-1"></i>
                        Confirmar Cancelamento
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- JAVASCRIPT MODAL -->
<script>

    const modalCancelarVenda = document.getElementById('modalCancelarVenda');

    modalCancelarVenda.addEventListener('show.bs.modal', function (event) {

        const botao = event.relatedTarget;

        const vendaId = botao.getAttribute('data-venda-id');
        const vendaCodigo = botao.getAttribute('data-venda-codigo');

        document.getElementById('cancelarVendaId').value = vendaId;

        document.getElementById('cancelarVendaCodigo').textContent =
            '#' + vendaCodigo;

        document.getElementById('senhaCancelarVenda').value = '';

    });

</script>

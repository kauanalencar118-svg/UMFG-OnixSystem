@model OnixSystem_MVC.Models.Entidades.Estoque

@{
    ViewData["Title"] = "Cadastrar Estoque";
}

<div class="container mt-4">

    <h2 class="mb-4">Cadastrar Estoque</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-controller="Estoque" asp-action="CriarPost" method="post">

                <div class="mb-3">
                    <label class="form-label">Produto</label>

                    <select asp-for="ProdutoId" class="form-select" required>
                        <option value="">Selecione um produto</option>

                        @foreach (var produto in ViewBag.Produtos)
                        {
                            <option value="@produto.Id">
                                @produto.Nome - @produto.Tamanho
                            </option>
                        }
                    </select>

                    <span asp-validation-for="ProdutoId" class="text-danger"></span>

                </div>

                <div class="mb-3">
                    <label asp-for="Quantidade" class="form-label">Quantidade atual</label>
                    <input asp-for="Quantidade" type="number" min="0" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="EstoqueMinimo" class="form-label">Estoque mínimo</label>
                    <input asp-for="EstoqueMinimo" type="number" min="0" class="form-control" required />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Salvar
                    </button>

                    <a asp-controller="Estoque" asp-action="Index" class="btn btn-secondary">
                        Voltar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>


@model IEnumerable<OnixSystem_MVC.Models.Entidades.Estoque>

@{
    ViewData["Title"] = "Estoques Inativos";
}

<div class="container mt-4">

    <h2 class="mb-4">Estoques Inativos</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Código / ID</th>
                            <th>Produto</th>
                            <th>Tamanho</th>
                            <th>Quantidade</th>
                            <th>Estoque Mínimo</th>
                            <th>Ação</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var estoque in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(estoque.Produto?.CodigoBarras))
                                    {
                                        @estoque.Produto.CodigoBarras
                                    }
                                    else
                                    {
                                        @estoque.ProdutoId
                                    }
                                </td>

                                <td>
                                    @(estoque.Produto?.Nome ?? "Produto não encontrado")
                                </td>

                                <td>
                                    @(estoque.Produto?.Tamanho ?? "Não informado")
                                </td>

                                <td>@estoque.Quantidade</td>

                                <td>@estoque.EstoqueMinimo</td>

                                <td>
                                    <form asp-controller="Estoque"
                                          asp-action="Reativar"
                                          asp-route-id="@estoque.Id"
                                          method="post">

                                        <button type="submit" class="btn btn-success btn-sm">
                                            Reativar
                                        </button>

                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            @if (!Model.Any())
            {
                <p class="text-center text-muted">
                    Não existem estoques desativados.
                </p>
            }

            <a asp-controller="Estoque"
               asp-action="Index"
               class="btn btn-secondary">
                Voltar
            </a>

        </div>
    </div>
</div>

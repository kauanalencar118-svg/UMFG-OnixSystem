@model OnixSystem_MVC.Models.Entidades.Estoque

@{
    ViewData["Title"] = "Atualizar Estoque";
}

<div class="container mt-4">

    <h2 class="mb-4">Atualizar Estoque</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-controller="Estoque" asp-action="AtualizarPost" method="post">

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ProdutoId" />

                <div class="mb-3">
                    <label class="form-label">Produto</label>
                    <input type="text" value="@(Model.Produto?.Nome ?? "Produto não encontrado")" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Quantidade" class="form-label">Quantidade atual</label>
                    <input asp-for="Quantidade" type="number" min="0" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="EstoqueMinimo" class="form-label">Estoque mínimo</label>
                    <input asp-for="EstoqueMinimo" type="number" min="0" class="form-control" required />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Salvar Alterações
                    </button>

                    <a asp-controller="Estoque" asp-action="Index" class="btn btn-secondary">
                        Voltar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

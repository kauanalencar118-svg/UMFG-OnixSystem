@{
    ViewData["Title"] = "Home Page";
}
<div class="home-container">
   <div>
       <h1>Olá Kauan</h1>
       <h2>Bem Vindo ao DashBoard,veja os seus resultados.</h2>
   </div>
   <div class="home-grid">
       <div class="home-square">a</div>
       <div class="home-square">a</div>
       <div class="home-square">a</div>
       <div class="home-square">a</div>
   </div>

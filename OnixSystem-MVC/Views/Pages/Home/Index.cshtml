<style>
    .home-container{
        display: flex;
        flex-direction: column;
    }
    .home-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr); 
        width: 100%;
        gap: 15px; 
        padding: 8px; 
        box-sizing: border-box;
    }
    
    .home-square {
        background: white; 
        box-shadow: 1px 2px 5px rgba(0, 0,0, 0.3);
        color: white;
        width: 100%;
        aspect-ratio: 4 / 3; 
        sdisplay: flex;
        align-items: center;
        justify-content: center;
        border-radius: 5px;
    }
</style>

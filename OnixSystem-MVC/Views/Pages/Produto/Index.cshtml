@model IEnumerable<OnixSystem_MVC.Models.Entidades.Produto>

@{
    ViewData["Title"] = "Produtos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Lista de Produtos</h2>

        <a asp-controller="Produto"
           asp-action="Criar"
           class="btn btn-primary">
            <i class="fa-solid fa-circle-plus"></i>
            Novo Produto
        </a>
    </div>

    <form asp-controller="Produto" asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text"
                   name="pesquisa"
                   value="@ViewBag.Pesquisa"
                   class="form-control"
                   placeholder="Pesquisar por nome ou código de barras..." />

            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-magnifying-glass"></i>
                Pesquisar
            </button>

            <a asp-controller="Produto"
               asp-action="Index"
               class="btn btn-secondary">
                Limpar
            </a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Nome</th>
                    <th>Tamanho</th>
                    <th>Preço</th>
                    <th>Código de Barras</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var produto in Model)
                    {
                        <tr>
                            <td>@produto.Nome</td>
                            <td>@produto.Tamanho</td>
                            <td>@produto.Preco</td>
                            <td>@produto.CodigoBarras</td>

                            <td class="text-center">
                                <a asp-controller="Produto"
                                   asp-action="Atualizar"
                                   asp-route-id="@produto.Id"
                                   class="btn btn-warning btn-sm">
                                    <i class="fa-solid fa-pencil"></i>
                                    Editar
                                </a>

                                <button type="button"
                                        class="btn btn-info btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalDetalhes"
                                        data-detalhes="@produto.Detalhes">
                                    <i class="fa-solid fa-rectangle-list"></i>
                                    Detalhes
                                </button>

                                <a asp-controller="Produto"
                                   asp-action="DeleteSoft"
                                   asp-route-id="@produto.Id"
                                   class="btn btn-danger btn-sm">
                                    <i class="fa-solid fa-trash"></i>
                                    Excluir
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">
                            Nenhum produto encontrado.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <!-- Modal de Detalhes -->
    <div class="modal fade" id="modalDetalhes" tabindex="-1" aria-labelledby="tituloModalDetalhes" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="tituloModalDetalhes">Detalhes do Produto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>

                <div class="modal-body">
                    <p id="textoDetalhes" class="mb-0"></p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Fechar
                    </button>
                </div>

            </div>
        </div>
    </div>
  
</div>
@section Scripts {
    <script>
        const modalDetalhes = document.getElementById('modalDetalhes');

        modalDetalhes.addEventListener('show.bs.modal', function (event) {
            const botao = event.relatedTarget;

            const detalhes = botao.getAttribute('data-detalhes');

            const textoDetalhes = document.getElementById('textoDetalhes');

            textoDetalhes.textContent = detalhes && detalhes.trim() !== ''
                ? detalhes
                : 'Nenhum detalhe informado.';
        });
    </script>
}

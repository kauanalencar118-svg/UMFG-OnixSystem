@model IEnumerable<OnixSystem_MVC.Models.Entidades.Produto>

@{
    ViewData["Title"] = "Produtos";
}

<div class="container mt-4 produtos-page">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 produtos-header">
        <h2 class="fw-bold mb-0">Lista de Produtos</h2>

        <a asp-controller="Produto"
           asp-action="Criar"
           class="btn btn-primary">
            <i class="fa-solid fa-circle-plus me-1"></i>
            Novo Produto
        </a>
    </div>

    <form asp-controller="Produto" asp-action="Index" method="get" class="mb-4 produtos-pesquisa">
        <div class="input-group pesquisa-produtos">
            <input type="text"
                   name="pesquisa"
                   value="@ViewBag.Pesquisa"
                   class="form-control"
                   placeholder="Pesquisar por nome ou código de barras..." />

            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-magnifying-glass me-1"></i>
                Pesquisar
            </button>

            <a asp-controller="Produto"
               asp-action="Index"
               class="btn btn-secondary">
                Limpar
            </a>
        </div>
    </form>

    <div class="table-responsive tabela-produtos-container">
        <table class="table table-striped table-hover table-bordered tabela-produtos">
            <thead>
                <tr>
                    <th class="col-nome">Nome</th>
                    <th class="col-tamanho">Tamanho</th>
                    <th class="col-preco">Preço</th>
                    <th class="col-codigo">Código de Barras</th>
                    <th class="col-acoes text-center">Ações</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var produto in Model)
                    {
                        <tr>
                            <td class="produto-nome">@produto.Nome</td>

                            <td class="produto-tamanho">@produto.Tamanho</td>

                            <td class="produto-preco">
                                @produto.Preco.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                            </td>

                            <td class="produto-codigo" title="@produto.CodigoBarras">
                                @produto.CodigoBarras
                            </td>

                            <td class="produto-acoes">
                                <div class="acoes-container">

                                    <a asp-controller="Produto"
                                       asp-action="Atualizar"
                                       asp-route-id="@produto.Id"
                                       class="btn btn-warning btn-sm btn-editar">
                                        <i class="fa-solid fa-pencil"></i>
                                        Editar
                                    </a>

                                    <button type="button"
                                            class="btn btn-info btn-sm btn-detalhes"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalDetalhes"
                                            data-detalhes="@produto.Detalhes">
                                        <i class="fa-solid fa-rectangle-list"></i>
                                        Detalhes
                                    </button>

                                    <a asp-controller="Produto"
                                       asp-action="DeleteSoft"
                                       asp-route-id="@produto.Id"
                                       class="btn btn-danger btn-sm btn-excluir">
                                        <i class="fa-solid fa-trash"></i>
                                        Excluir
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4">
                            Nenhum produto encontrado.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Modal de Detalhes -->
    <div class="modal fade" id="modalDetalhes" tabindex="-1" aria-labelledby="tituloModalDetalhes" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="tituloModalDetalhes">
                        <i class="fa-solid fa-box me-2"></i>
                        Detalhes do Produto
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Fechar">
                    </button>
                </div>

                <div class="modal-body">
                    <p id="textoDetalhes" class="mb-0"></p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Fechar
                    </button>
                </div>

            </div>
        </div>
    </div>

</div>

<style>
    /* Estrutura da página */
    .produtos-page {
        color: #18324F;
        height: calc(100vh - 110px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .produtos-page h2 {
        color: #071C33;
    }

    .produtos-header,
    .produtos-pesquisa {
        flex-shrink: 0;
    }

    /* Tabela */
    .tabela-produtos-container {
        border-radius: 10px;
        overflow: auto;
        flex: 1;
        min-height: 0;
        border: 1px solid #DCE5EF;
        background-color: #FFFFFF;
    }

    .tabela-produtos {
        margin-bottom: 0;
        min-width: 1000px;
        table-layout: fixed;
        width: 100%;
    }

    .tabela-produtos thead th {
        background-color: #071C33;
        color: #FFFFFF;
        border-color: #18324F;
        padding: 14px 12px;
        vertical-align: middle;
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    .tabela-produtos tbody td {
        padding: 12px;
        vertical-align: middle;
        color: #18324F;
        border-color: #DCE5EF;
    }

    .tabela-produtos tbody tr {
        height: auto;
    }

    /* Largura das colunas */
    .col-nome {
        width: 24%;
    }

    .col-tamanho {
        width: 8%;
        text-align: center;
    }

    .col-preco {
        width: 12%;
    }

    .col-codigo {
        width: 21%;
    }

    .col-acoes {
        width: 35%;
    }

    /* Nome */
    .produto-nome {
        overflow-wrap: break-word;
        word-break: normal;
    }

    /* Tamanho */
    .produto-tamanho {
        text-align: center;
        white-space: nowrap;
    }

    /* Preço */
    .produto-preco {
        white-space: nowrap;
        font-weight: 600;
    }

    /* Código de barras */
    .produto-codigo {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 0;
    }

    /* Botões */
    .produto-acoes {
        text-align: center;
    }

    .acoes-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        flex-wrap: nowrap;
    }

    .acoes-container .btn {
        white-space: nowrap;
        flex-shrink: 0;
        opacity: 1 !important;
        font-weight: 600;
    }

    /* Editar */
    .acoes-container .btn-editar {
        background-color: #FFF3CD;
        border-color: #FFF3CD;
        color: #856404 !important;
    }

    .acoes-container .btn-editar:hover {
        background-color: #FFDF80;
        border-color: #FFDF80;
        color: #664D03 !important;
    }

    /* Detalhes */
    .acoes-container .btn-detalhes {
        background-color: #E0F2FE;
        border-color: #E0F2FE;
        color: #075985 !important;
    }

    .acoes-container .btn-detalhes:hover {
        background-color: #BAE6FD;
        border-color: #BAE6FD;
        color: #03496D !important;
    }

    /* Excluir */
    .acoes-container .btn-excluir {
        background-color: #FEE2E2;
        border-color: #FEE2E2;
        color: #B91C1C !important;
    }

    .acoes-container .btn-excluir:hover {
        background-color: #FECACA;
        border-color: #FECACA;
        color: #991B1B !important;
    }

    /* Pesquisa */
    .pesquisa-produtos .form-control {
        min-width: 0;
    }

    /* Modal */
    #modalDetalhes .modal-content {
        border-radius: 12px;
        border: 1px solid #DCE5EF;
    }

    #modalDetalhes .modal-header {
        background-color: #F5F8FC;
        color: #071C33;
    }

    #modalDetalhes .modal-body {
        color: #18324F;
    }

    /* Responsividade */
    @@media (max-width: 768px) {
        .produtos-page {
            height: calc(100vh - 75px);
        }

        .produtos-page h2 {
            font-size: 1.4rem;
        }

        .acoes-container {
            justify-content: flex-start;
        }
    }
</style>

@section Scripts {
    <script>
        const modalDetalhes = document.getElementById('modalDetalhes');

        modalDetalhes.addEventListener('show.bs.modal', function (event) {
            const botao = event.relatedTarget;
            const detalhes = botao.getAttribute('data-detalhes');
            const textoDetalhes = document.getElementById('textoDetalhes');

            textoDetalhes.textContent = detalhes && detalhes.trim() !== ''
                ? detalhes
                : 'Nenhum detalhe informado.';
        });
    </script>
}
@model OnixSystem_MVC.Models.Entidades.Produto

@{
    ViewData["Title"] = "Atualizar Produto";
}

<div class="container mt-4">

    <h2 class="mb-4">Atualizar Produto</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-controller="Produto"
                  asp-action="AtualizarPost"
                  method="post">

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label">
                        Nome do Produto
                    </label>

                    <input asp-for="Nome"
                           class="form-control"
                           placeholder="Digite o nome do produto" />

                    <span asp-validation-for="Nome"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tamanho" class="form-label">
                        Tamanho
                    </label>

                    <input asp-for="Tamanho"
                           class="form-control"
                           placeholder="Digite o tamanho do produto"
                           required />

                    <span asp-validation-for="Tamanho"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Detalhes" class="form-label">Detalhes (opcional)</label>
                    <textarea asp-for="Detalhes"
                              class="form-control"
                              rows="3"
                              placeholder="Digite detalhes adicionais do produto (opcional)"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Preco" class="form-label">
                        Preço
                    </label>

                    <input asp-for="Preco"
                           class="form-control"
                           placeholder="Ex.: 19,90" />

                    <span asp-validation-for="Preco"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CodigoBarras" class="form-label">
                        Código de Barras
                    </label>

                    <input asp-for="CodigoBarras"
                           class="form-control"
                           placeholder="Digite o código de barras" />

                    <span asp-validation-for="CodigoBarras"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Salvar Produto
                    </button>

                    <a asp-controller="Produto"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Voltar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

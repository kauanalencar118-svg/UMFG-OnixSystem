
@model OnixSystem_MVC.Models.Entidades.Produto

@{
    ViewData["Title"] = "Cadastrar Produto";
}

<div class="container mt-4">

    <h2 class="mb-4">Cadastrar Produto</h2>

    <div class="card shadow-sm" style="overflow-y: auto; height: 500px;">
        <div class="card-body">

            <form asp-controller="Produto"
                  asp-action="CriarPost"
                  method="post">

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label">
                        Nome do Produto
                    </label>

                    <input asp-for="Nome"
                           class="form-control"
                           placeholder="Digite o nome do produto" />

                    <span asp-validation-for="Nome"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tamanho" class="form-label">
                        Tamanho
                    </label>

                    <input asp-for="Tamanho"
                           class="form-control"
                           placeholder="Digite o tamanho do produto" />

                    <span asp-validation-for="Tamanho"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Detalhes" class="form-label">
                        Detalhes (opcional)
                    </label>

                    <textarea asp-for="Detalhes"
                              class="form-control"
                              rows="3"
                              placeholder="Digite detalhes adicionais do produto (opcional)"></textarea>

                    <span asp-validation-for="Detalhes"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="Preco" class="form-label">
                        Preço
                    </label>

                    <input type="text"
                           id="Preco"
                           name="Preco"
                           class="form-control"
                           inputmode="decimal"
                           placeholder="Ex.: 89,90"
                           value="@Model?.Preco.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))" />

                    <span asp-validation-for="Preco"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CodigoBarras" class="form-label">
                        Código de Barras
                    </label>

                    <input asp-for="CodigoBarras"
                           class="form-control"
                           placeholder="Digite o código de barras" />

                    <span asp-validation-for="CodigoBarras"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Salvar Produto
                    </button>

                    <a asp-controller="Produto"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Voltar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

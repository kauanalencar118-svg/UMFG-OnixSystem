
@{
    ViewData["Title"] = "Relatórios";
}

<div class="container-fluid p-4 overflow-hidden">

    <h2 class="mb-2">Relatórios</h2>

    <p class="text-muted mb-4">
        Visualize e acompanhe os dados do seu negócio.
    </p>

    <div class="row g-4">

        <!-- RELATÓRIO DE ESTOQUE -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body text-center p-4">

                    <i class="fa-solid fa-boxes-stacked fa-3x text-primary mb-3"></i>

                    <h5 class="fw-bold">Estoque</h5>

                    <p class="text-muted">
                        Visualize o relatório de estoque
                        dos produtos da loja.
                    </p>

                    <a asp-controller="Estoque"
                       asp-action="Relatorio"
                       class="btn btn-primary w-100">
                        Acessar relatório
                    </a>

                </div>
            </div>
        </div>

        <!-- RELATÓRIO DE VENDAS -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body text-center p-4">

                    <i class="fa-solid fa-chart-line fa-3x text-primary mb-3"></i>

                    <h5 class="fw-bold">Vendas</h5>

                    <p class="text-muted">
                        Acompanhe o histórico de vendas
                        realizadas pela loja.
                    </p>

                    <a asp-controller="Venda"
                       asp-action="Relatorio"
                       class="btn btn-primary w-100">
                        Acessar relatório
                    </a>

                </div>
            </div>
        </div>

        <!-- RELATÓRIO DE FATURAMENTO -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body text-center p-4">

                    <i class="fa-solid fa-sack-dollar fa-3x text-primary mb-3"></i>

                    <h5 class="fw-bold">Faturamento</h5>

                    <p class="text-muted">
                        Visualize o faturamento da loja
                        por período selecionado.
                    </p>

                    <a asp-controller="Faturamento"
                       asp-action="Relatorio"
                       class="btn btn-primary w-100">
                        Acessar relatório
                    </a>

                </div>
            </div>
        </div>

    </div>

</div>

@model OnixSystem_MVC.Models.Entidades.Cliente

@{
    ViewData["Title"] = "Cadastrar Cliente";
}

 <div class="container mt-4">
     <h2 class="mb-4">Cadastrar Cliente</h2>

     <div class="card shadow-sm">
        
        <div class="card-body">
             
             
         <form asp-controller="Cliente"
             asp-action="CriarPost"
             method="Post">
            
             <div class="mb-3">
                 <label asp-for="Nome" class="form-label">
                     Nome do Cliente
                 </label>

                 <input asp-for="Nome"
                    class="form-control"
                    placeholder="Digite o nome do cliente" />

                    <span aps-validation-for="Nome"
                    class="text-danger"></span>

             </div>
             
             <div class="mb-3">
                 <label asp-for="CPF" class="form-label">
                     CPF
                 </label>

                 <input asp-for="CPF"
                 class="form-control"
                 placeholder="Digite o CPF" />

                 <span asp-validation-for="CPF"
                 class="text-danger"></span>
             </div>

             <div class="mb-3">
                 <label asp-for="Telefone" class="form-label">
                     Telefone
                 </label>

                 <input asp-for="Telefone"
                 class="form-control"
                 placeholder="Digite o Telefone" />

                 <span asp-validation-for="Telefone"
                 class="text-danger"></span>
             </div>

             <div class="mb-3">
                 <label asp-for="Email" class="form-label">
                     E-mail
                 </label>

                 <input asp-for="Email"
                 class="form-control"
                 placeholder="Digite o e-mail" />

                 <span asp-validation-for="Email"
                 class="text-danger"></span>
             </div>
                <div class="mb-3">
                    <label asp-for="Endereco" class="form-label">
                        Endereço
                    </label>

                    <input asp-for="Endereco"
                           class="form-control"
                           placeholder="Digite o endereço" />

                    <span asp-validation-for="Endereco"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-primary">
                        Salvar Cliente
                    </button>

                    <a asp-controller="Cliente"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Voltar
                    </a> 

                </div>
            

         </form>

         </div>
     </div>
 </div>
 @section Scripts{
     <partial name="_ValidationScriptsPartial" />
 }
@model OnixSystem_MVC.Models.Entidades.Cliente

@{
    ViewData["Title"] = "Desativar Cliente";
}

<div class="container mt-4">

    <h2 class="mb-4">Desativar Cliente</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="text-danger mb-3">
                Tem certeza que deseja desativar este cliente?
            </h5>

            <dl class="row">

                <dt class="col-sm-3">Nome:</dt>
                <dd class="col-sm-9">@Model.Nome</dd>

                <dt class="col-sm-3">CPF:</dt>
                <dd class="col-sm-9">@Model.CPF</dd>

                <dt class="col-sm-3">Telefone:</dt>
                <dd class="col-sm-9">@Model.Telefone</dd>

                <dt class="col-sm-3">E-mail:</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Endereço:</dt>
                <dd class="col-sm-9">@Model.Endereco</dd>

            </dl>

            <form asp-controller="Cliente"
                  asp-action="DeleteSoftPost"
                  method="post">

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label">Digite a senha para confirmar:</label>
                    <input type="password"
                           name="senha"
                           class="form-control"
                           required />
                </div>

                @if (TempData["Erro"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["Erro"]
                    </div>
                }

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-danger">
                        Confirmar Desativação
                    </button>

                    <a asp-controller="Cliente"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

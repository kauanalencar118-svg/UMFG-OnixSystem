@model IEnumerable<OnixSystem_MVC.Models.Entidades.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="container mt-4">

    <div class="mb-3">

        <a asp-controller="Cliente"
           asp-action="Criar"
           class="btn btn-primary">
            Novo Cliente
        </a>

        <a asp-controller="Cliente"
           asp-action="Inativos"
           class="btn btn-warning">
            Clientes Inativos
        </a>

    </div>

    <!-- Pesquisa de clientes -->
    <form asp-controller="Cliente" asp-action="Index" method="get" class="mb-3">
        <div class="input-group">

            <input type="text"
                   name="pesquisa"
                   value="@ViewBag.Pesquisa"
                   class="form-control"
                   placeholder="Pesquisar por nome, CPF, telefone ou e-mail..." />

            <button type="submit" class="btn btn-primary">
                Pesquisar
            </button>

            <a asp-controller="Cliente"
               asp-action="Index"
               class="btn btn-secondary">
                Limpar
            </a>

        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover table-striped align-middle">

                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>CPF</th>
                            <th>Telefone</th>
                            <th>E-mail</th>
                            <th>Endereço</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var cliente in Model)
                            {
                                <tr>
                                    <td>@cliente.Nome</td>
                                    <td>@cliente.CPF</td>
                                    <td>@cliente.Telefone</td>
                                    <td>@cliente.Email</td>
                                    <td>@cliente.Endereco</td>

                                    <td class="text-center">

                                        <a asp-controller="Cliente"
                                           asp-action="Atualizar"
                                           asp-route-id="@cliente.Id"
                                           class="btn btn-warning btn-sm">
                                            Editar
                                        </a>

                                        <a asp-controller="Cliente"
                                           asp-action="DeleteSoft"
                                           asp-route-id="@cliente.Id"
                                           class="btn btn-danger btn-sm">
                                            Excluir
                                        </a>

                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">
                                    Nenhum cliente encontrado.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnixSystem_MVC</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/layout.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/OnixSystem_MVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
</head>
<body class="h-100">
   
    <div class="body-grid">

        <div class="sidebar">
             <div class="sidebar-title">
                 
                <a asp-action="Index" asp-controller="Home">
                    OnixSystem
                </a>

            </div>

            <div class="sidebar-container">
                
                <a class="sidebar-items" asp-action="Index" asp-controller="Produto">
                  <i class="fa-solid fa-tags"></i>
                    Produto
                </a>
                 
                <a class="sidebar-items" asp-action="Index" asp-controller="Venda">
                <i class="fa-solid fa-cart-shopping"></i>
                Venda
                </a>

                <a class="sidebar-items" asp-action="Index" asp-controller="Cliente">
                    <i class="fa-solid fa-user"></i>
                    Clientes
                </a>

                <a class="sidebar-items" asp-action="Index" asp-controller="Fornecedor">
                     <i class="fa-solid fa-truck-front"></i>
                    Fornecedores
                </a>

                 <a class="sidebar-items" asp-action="Index" asp-controller="Estoque">
                   <i class="fa-solid fa-box"></i>
                    Estoque
                </a>
                <a class="sidebar-items"
                   asp-action="Index"
                   asp-controller="Relatorio">
                    <i class="fa-solid fa-chart-simple"></i>
                    Relatórios
                </a>

                <a class="sidebar-items"
                    href="@Url.Action("Index", "Configuracao")">
                    <i class="fa-solid fa-gear"></i>
                    Configurações
                </a>
            </div>
           
            
        </div>

        <div class="main-grid">
            <div class="navbarr">
                <div class="navbar-perfil">
                     <a asp-action="Index" asp-controller="Home">Kauan</a>
                <span>Administrador</span>
                </div>
               

            </div>
            <main role="main" class="">
                @RenderBody()

            </main>
        </div>

    </div>

    <style>
       

        
    </style>
   
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
